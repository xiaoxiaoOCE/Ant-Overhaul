# Generated release policy reader; hashes are pinned by the release builder.
$script:ReleasePolicySha='@@POLICY_SHA@@'
function PolicyChild([string]$Root,[string]$Relative) {
 if([string]::IsNullOrWhiteSpace($Relative) -or [IO.Path]::IsPathRooted($Relative) -or $Relative -match '(^|[\\/])\.\.?([\\/]|$)|:|[\x00-\x1f]'){throw 'Unsafe release path'}
 $base=[IO.Path]::GetFullPath($Root).TrimEnd('\','/');$path=[IO.Path]::GetFullPath((Join-Path $base $Relative))
 if(-not $path.StartsWith($base+'\',[StringComparison]::OrdinalIgnoreCase)){throw 'Release path escaped root'}
 $p=$path;while($p){if((Test-Path -LiteralPath $p) -and ((Get-Item -LiteralPath $p -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)){throw 'Release path contains reparse point'};$next=Split-Path -Parent $p;if($next -eq $p){break};$p=$next}
 return $path
}
function PolicyHash([string]$Path){
 $p=[IO.Path]::GetFullPath($Path);while($p){if((Test-Path -LiteralPath $p)-and((Get-Item -LiteralPath $p -Force).Attributes-band[IO.FileAttributes]::ReparsePoint)){throw 'Hash target contains reparse point'};$n=Split-Path -Parent $p;if($n-eq$p){break};$p=$n}
 $stream=[IO.File]::OpenRead($Path);$h=[Security.Cryptography.SHA256]::Create()
 try{return([BitConverter]::ToString($h.ComputeHash($stream))).Replace('-','').ToLowerInvariant()}finally{$stream.Dispose();$h.Dispose()}
}
function ReadReleasePolicy {
 $path=PolicyChild $script:PackageRoot 'release-policy.json'
 if((PolicyHash $path) -cne $script:ReleasePolicySha){throw 'Release policy integrity mismatch'}
 $p=Get-Content -LiteralPath $path -Raw -Encoding UTF8|ConvertFrom-Json
 if($p.schema -ne 1 -or $p.modId -cne 'EotU.AllAttributes.v1' -or $p.release -cne '@@RELEASE@@'){throw 'Unexpected release policy'}
 return $p
}
function PolicyMap($Manifest) {
 if($Manifest.schema -ne 1 -or $Manifest.modId -cne 'EotU.AllAttributes.v1'){throw 'Invalid manifest identity'}
 $matches=@()
 foreach($known in @($script:ReleasePolicy.target)+@($script:ReleasePolicy.baselines)) {
  if([string]$Manifest.release -cne [string]$known.release -or [string]$Manifest.buildId -cne [string]$known.buildId -or @($Manifest.files).Count -ne @($known.files).Count){continue}
  $expected=@{};foreach($f in @($known.files)){$expected[[string]$f.path]=$f}
  $seen=@{};$same=$true
  foreach($f in @($Manifest.files)) {
   $path=[string]$f.path
   if($path -cnotin @($expected.Keys) -or $seen.ContainsKey($path) -or $f.sha256 -cne $expected[$path].sha256 -or [long]$f.length -ne [long]$expected[$path].length){$same=$false;break}
   [void](PolicyChild $script:GameRoot $path);$seen[$path]=$f
  }
  if($same){$matches+=@($seen)}
 }
 if($matches.Count -lt 1){throw 'No frozen release file set matches this manifest or installation record'}
 return $matches[0]
}
function PolicyAllowed([string]$Relative,[string]$Release) {
 $path=$Relative.Replace('\','/');[void](PolicyChild $script:GameRoot $path)
 foreach($known in @($script:ReleasePolicy.target)+@($script:ReleasePolicy.baselines)) {
  if([string]$known.release -ceq $Release -and $path -cin @($known.files|ForEach-Object path)){return}
 }
 throw ('Path is not managed by the frozen release: '+$path)
}
function PolicyDirectories($Files) {
 $all=@{}
 foreach($f in @($Files)) {
  $p=([string]$f.path).Replace('\','/');$i=$p.LastIndexOf('/')
  while($i -gt 0){$p=$p.Substring(0,$i);$all[$p]=$true;$i=$p.LastIndexOf('/')}
 }
 return @($all.Keys|Sort-Object Length)
}
function PolicyNewDirectories($Files) {
 return @(PolicyDirectories $Files|Where-Object {-not(Test-Path -LiteralPath (PolicyChild $script:GameRoot $_))})
}
function PolicyReadTarget {
 $path=PolicyChild $script:PackageRoot 'manifest.json'
 if((PolicyHash $path) -cne $script:ReleasePolicy.manifestSha256){throw 'Release manifest integrity mismatch'}
 $m=Get-Content -LiteralPath $path -Raw -Encoding UTF8|ConvertFrom-Json
 if($m.release -cne $script:ReleasePolicy.release -or [string]$m.appId -cne '463530'){throw 'Wrong release target'}
 [void](PolicyMap $m);return $m
}
